{
  "name": "household-finance-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private, local-first household spending and income tracker. All financial data stays in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:build": "node scripts/check-build-output.mjs",
    "check:repo": "node scripts/check-repo-hygiene.mjs",
    "verify": "npm run typecheck && npm test && npm run check:repo && npm run build && npm run check:build && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
