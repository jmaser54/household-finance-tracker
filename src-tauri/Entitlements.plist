<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS App Sandbox. Besides the sandbox itself, the ONLY entitlement is
  network.client, because Apple's WebKit will not load even the app's own
  bundled page in a sandboxed app without it (shown in CI, Phase A). It means
  macOS PERMITS outgoing connections; it does not mean the app makes any. The
  app has no networking code, its window cannot fetch or navigate off-app,
  and CI checks for network activity (docs/ARCHITECTURE.md §4, §11).
  files.user-selected.read-write: the app may read or write only a file the
  person picks in a save or open panel (backups). No other files.
  No network.server, hardware or personal-data entitlements.
  Do not add entries without updating PROJECT_PRINCIPLES.md §3.1 and
  scripts/check-desktop-config.mjs.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
