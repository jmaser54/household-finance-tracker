<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS App Sandbox with nothing else granted: no network (client or server),
  no hardware, no personal data, no file access beyond the app's own container.
  File access for chosen PDFs and backups is added only when those features
  exist. Do not add entries without updating PROJECT_PRINCIPLES.md §3.1 and
  scripts/check-desktop-config.mjs.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
